# ────────────────────────────────────────────────────────────────────────────
# TikTally Creator — variáveis de ambiente (frontend, prefixo VITE_)
# Copie para .env e preencha. NÃO commite o .env real.
# ────────────────────────────────────────────────────────────────────────────

# Supabase (projeto PRÓPRIO do creator — não reusar o do TikTally-seller)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Opcional: custom domain das edge functions (senão cai no host default do projeto)
VITE_SUPABASE_FUNCTIONS_URL=

# URL pública do app (usada no redirect do OAuth de creator)
VITE_PUBLIC_URL=http://localhost:8091

# Camada de dados: "true" (default) usa os fixtures da doc; "false" chama a TikTok real via edge.
VITE_USE_MOCK=true

# TikTok Shop — App (mesmas credenciais podem ser reusadas do app TikTally,
# desde que o app tenha os escopos creator.* liberados; ver docs/SETUP.md)
VITE_TIKTOK_APP_KEY=
VITE_TIKTOK_SERVICE_ID=
VITE_TIKTOK_API_MODE=production          # production | sandbox
VITE_TIKTOK_REGION=BR

# ────────────────────────────────────────────────────────────────────────────
# Secrets abaixo NÃO vão no frontend — cadastrar em Supabase → Edge Functions → Secrets:
#   TIKTOK_APP_KEY, TIKTOK_APP_SECRET, TIKTOK_ENV=production, TIKTOK_SERVICE_ID
# ────────────────────────────────────────────────────────────────────────────
