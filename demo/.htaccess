# ============================================================================
# Demo de feira do TikTally Creator — o app REAL rodando com dados fictícios,
# fechado por login e senha.
#
# Diferente do tiktally-demo, que serve um HTML único: aqui é um SPA com rotas
# (/ganhos, /analytics, /amostras...), então este arquivo faz DUAS coisas —
# fecha a porta e devolve o index.html para qualquer rota. Sem o fallback,
# atualizar a página em /ganhos dá 404 no meio da demonstração.
#
# Ordem importa: o Basic Auth vem primeiro. O RewriteRule roda no fixup, depois
# da autenticação, então nenhuma rota escapa do portão.
#
# {{DOCROOT}} é substituído no build pelo caminho absoluto da pasta no servidor.
# O AuthUserFile do Apache só aceita caminho absoluto, e ele muda de conta pra
# conta; o deploy resolve isso sozinho pela API da Hostinger.
# ============================================================================

# --- Login e senha -------------------------------------------------------
AuthType Basic
AuthName "TikTally Creator: demonstração"
AuthUserFile "{{DOCROOT}}/.htpasswd"
Require valid-user

# --- HTTPS ---------------------------------------------------------------
# Basic Auth manda usuario:senha em base64, que é texto aberto sem TLS. Este
# redirect roda DEPOIS da autenticação, então ele não substitui o "Forçar
# HTTPS" do hPanel. Ligue lá também — e numa feira isso importa mais que o
# normal, porque o Wi-Fi é de terceiros.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Fallback de SPA ---------------------------------------------------
  # Não reescreve arquivo nem diretório que existe de verdade (os bundles).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Backup: cobre mod_rewrite desabilitado ou AllowOverride sem FileInfo.
<IfModule mod_dir.c>
  FallbackResource /index.html
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  # Demonstração não entra em buscador — nem o Google nem um concorrente
  # curioso precisam achar isto.
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Não servir o arquivo de senha nem listar diretório -------------------
Options -Indexes

<Files ".ht*">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_mime.c>
  AddType application/javascript js mjs
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Os bundles têm hash no nome, então cache longo é seguro.
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # HTML nunca em cache: é ele que aponta pros bundles novos a cada deploy.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
